generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model appointments {
  appt_id         Int?
  patient_id      Int?
  patient_nm      String?          @db.VarChar(255)
  patient_ph      String?          @db.VarChar(255)
  doc_id          Int?
  doc_name        String?          @db.VarChar(255)
  appt_date       String?          @db.VarChar(50)
  status          String?          @db.Char(1)
  fee             Float?           @db.Float
  discount        Float?           @db.Float
  net_fee         Float?           @db.Float
  room            String?          @db.VarChar(255)
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime         @default(now()) @db.Timestamp(0)

  @@ignore
}

model appt_status_ref {
  status_code  String @id @db.Char(1)
  description  String @db.VarChar(50)
}

model billing {
  bill_no    String      @id @db.VarChar(50)
  pid        Int?
  pname      String?     @db.VarChar(255)
  services   String?     @db.Text
  svc_cost   Float?      @db.Float
  tax_pct    Float?      @db.Float
  paid       Float?      @db.Float
  created    String?     @db.VarChar(50)
  created_by String?     @db.VarChar(255)
  pat_master pat_master? @relation(fields: [pid], references: [pid], onDelete: Restrict, onUpdate: Restrict, map: "fk_billing_patient")

  @@index([pid], map: "fk_billing_patient")
}

model departments {
  dept_id Int     @id
  dept_nm String? @db.VarChar(255)
  hod     String? @db.VarChar(255)
  budget  Float?  @db.Float
}

model doctors {
  doctor_id      Int     @id
  full_name      String? @db.VarChar(255)
  speciality     String? @db.VarChar(255)
  contact_no     String? @db.VarChar(255)
  join_date      String? @db.VarChar(50)
  salary_monthly Float?  @db.Float
  dept_id        Int?
  is_active      String? @db.Char(1)
}

model pat_master {
  pid          Int       @id
  p_name       String?   @db.VarChar(255)
  dob          String?   @db.VarChar(50)
  sex          String?   @db.Char(1)
  ph1          String?   @db.VarChar(255)
  ph2          String?   @db.VarChar(255)
  ph3          String?   @db.VarChar(255)
  addr1        String?   @db.VarChar(255)
  addr2        String?   @db.VarChar(255)
  city         String?   @db.VarChar(255)
  reg_doc      String?   @db.VarChar(255)
  reg_doc_id   String?   @db.VarChar(255)
  total_visits Int?
  last_bill    Float?    @db.Float
  notes        String?   @db.Text
  billing      billing[]
}